{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "190x4 Browser",
  "version": "0.1.0",
  "identifier": "pw.x190x4.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "chrome",
        "title": "190x4",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://*; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 pathetixx · 190x4",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "lists/*": "lists/",
      "../pages/**/*": "pages/"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNUE4NUMwQzk1NkMxOUEKUldTYXdWYkp3SVZhN2hnYm1mUWJOZlpnRk9zY3NrVkR6WTNjRlN5MHB5K2t5d3FRZnBGL0NVejgK",
      "endpoints": [
        "https://gitlab.com/api/v4/projects/86438976/packages/generic/190x4-browser/stable/latest.json",
        "https://github.com/pathetixx/190x4-Browser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "190x4-browser"
}
